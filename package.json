{
  "name": "@sendevia/pi-ask-author",
  "version": "1.0.2",
  "description": "面向文字创作者的决策询问 Pi 扩展",
  "keywords": [
    "pi-package",
    "pi-extension",
    "tui",
    "creative-writing",
    "novel",
    "author-consultation"
  ],
  "repository": {
    "type": "git",
    "url": "ssh://git@git.sendevia.top:26621/sendevia/pi-ask-author.git"
  },
  "license": "MIT",
  "author": "sendevia",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly --declaration --outDir dist && esbuild src/index.ts --bundle --format=esm --platform=node --target=ESNext --external:@earendil-works/* --external:typebox --minify --tree-shaking=true --legal-comments=none --drop:debugger --drop:console --outfile=dist/index.js",
    "prepack": "pnpm build",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "esbuild": "^0.28.2",
    "typebox": "^1.3.31",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
