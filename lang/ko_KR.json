{
  "tool": { "label": "작가에게 문의" },
  "command": {
    "name": "ask-author",
    "description": "ask_author 창작 문의 도구 설명 보기",
    "notify": "프롬프트에서 AI에게 ask_author 호출을 지시하면 창작 결정에 대해 문의합니다"
  },
  "common": { "optionSeparator": ", ", "bulletPrefix": "• ", "helpSeparator": " • " },
  "tabs": {
    "questionTab": { "template": "질문 {index}", "params": ["index"] },
    "submitTab": { "template": "{icon.check} 답변 제출" }
  },
  "view": {
