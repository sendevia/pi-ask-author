{
  "tool": {
    "label": "Consult Author"
  },
  "command": {
    "name": "ask-author",
    "description": "Show the ask_author consultation tool reference",
    "notify": "Ask the AI to call ask_author in your prompt to consult you on creative decisions"
  },
  "common": {
    "optionSeparator": ", ",
    "bulletPrefix": "• ",
    "helpSeparator": " • "
  },
  "tabs": {
    "questionTab": {
      "template": "Q{index}",
      "params": [
        "index"
      ]
    },
    "expansionPlaceholder": "expanding…",
    "submitTab": {
      "template": "{icon.check} Submit"
    }
  },
  "view": {
    "modeSingle": "[Single]",
    "conditionalBadge": "[Conditional]",
    "expansionBadge": "[Expand]",
    "expansionPendingHint": "Question switching and answering are paused while the follow-up is generated; new questions and options appear in place when it finishes",
    "modeMultiAtLeast": {
      "template": "[Multi, at least {min}{maxPart}]",
      "params": [
        "min",
        "maxPart"
      ]
    },
    "modeMultiOptional": {
      "template": "[Multi, optional{maxPart}]",
      "params": [
        "maxPart"
      ]
    },
    "modeMultiUnconstrained": {
      "template": "[Multi{maxPart}]",
      "params": [
        "maxPart"
      ]
    },
    "modeMultiMaxPart": {
      "template": ", up to {max}",
      "params": [
        "max"
      ]
    },
    "attachedNoteBanner": {
      "template": "{icon.note} Question note: {text}",
      "params": [
        "text"
      ]
    },
    "optionAttachedNoteBanner": {
      "template": "{icon.note} [{label}] option note: {text}",
      "params": [
        "label",
        "text"
      ]
    },
    "listTopMore": {
      "template": "  {icon.scrollUp} {count} more above",
      "params": [
        "count"
      ]
    },
    "listBottomMore": {
      "template": "  {icon.scrollDown} {count} more below",
      "params": [
        "count"
      ]
    },
    "optionNotePanelTitle": "Option Note",
    "storyDescriptionPanelTitle": "Plot Deduction",
    "storyDraftPanelTitle": "Draft / Storyboard Preview",
    "previewScrollInfo": {
      "template": "(lines {start}-{end}/{total}, use [ ] to scroll)",
      "params": [
        "start",
        "end",
        "total"
      ]
    },
    "previewNoDraft": "(nothing to preview)",
    "sectionTitle": {
      "template": "### {title}",
      "params": [
        "title"
      ]
    },
    "italicLine": {
      "template": "_{text}_",
      "params": [
        "text"
      ]
    }
  },
  "menu": {
    "customNoteLabel": {
      "template": "{icon.note} Question note"
    },
    "customNoteLabelFilled": {
      "template": "{icon.note} Question note (filled)"
    },
    "confirmDetailMulti": {
      "template": "{selectedCount} selected",
      "params": [
        "selectedCount",
        "minSelect"
      ]
    },
    "confirmDetailMultiBelowMin": {
      "template": "{selectedCount}/{minSelect} selected",
      "params": [
        "selectedCount",
        "minSelect"
      ]
    },
    "confirmLabel": {
      "template": "{icon.check} Confirm question ({detail}{noteSuffix})",
      "params": [
        "detail",
        "noteSuffix"
      ]
    },
    "confirmNoteSuffix": " + note"
  },
  "editor": {
    "title": {
      "template": " {icon.note} Question note ({questionTitle})",
      "params": [
        "questionTitle"
      ]
    },
    "optionTitle": {
      "template": " {icon.note} Option note ({optionLabel} - {questionTitle})",
      "params": [
        "questionTitle",
        "optionLabel"
      ]
    },
    "formTitle": {
      "template": " {icon.note} Form supplement ({formTitle})",
      "params": [
        "formTitle"
      ]
    },
    "footerHelp": " [Enter] save and return • [Esc/Ctrl+C] cancel"
  },
  "status": {
    "questionNoteSaved": "Question note saved",
    "noteCleared": "Question note cleared",
    "formNoteSaved": "Form supplement saved",
    "formNoteCleared": "Form supplement cleared",
    "optionNoteSaved": {
      "template": "Saved note for {label}",
      "params": [
        "label"
      ]
    },
    "optionNoteSavedUnselected": {
      "template": "Saved note for {label} (option not selected; submitted as a note only)",
      "params": [
        "label"
      ]
    },
    "optionNoteSavedAtLimit": {
      "template": "Limit reached (up to {max} options): note saved, option left unselected",
      "params": [
        "max"
      ]
    },
    "optionNoteCleared": {
      "template": "Cleared note for {label}",
      "params": [
        "label"
      ]
    },
    "selectedUpToLimit": {
      "template": "Selection limit reached (up to {limit} items)",
      "params": [
        "limit"
      ]
    },
    "maxSelectExceeded": {
      "template": "Limit reached (up to {max} items): press \"Space\" to deselect an item first",
      "params": [
        "max"
      ]
    },
    "minSelectRequired": {
      "template": "Below minimum (at least {min} required): press \"Space\" to select more, or press \"n/N\" to write a note",
      "params": [
        "min"
      ]
    },
    "pleaseAnswerBeforeSubmit": "Question not answered: press \"Space/Enter\" to pick an option, or press \"n/N\" to write a note",
    "editorDiscardConfirm": "Press Esc/Ctrl+C again to discard changes (unsaved content will be lost); keep typing to cancel",
    "errorNonTui": "The current environment is not an interactive terminal, so the interface cannot start; retry in an interactive TUI session",
    "errorNoQuestions": "No valid question or option was provided; provide at least one question with options",
    "errorInvalidCondition": {
      "template": "Invalid adaptive condition: {details} (make showIf reference an earlier question and an existing option label, or use answered)",
      "params": [
        "details"
      ]
    },
    "errorExecutionFailed": {
      "template": "Component failure: {reason} (fix the arguments and retry)",
      "params": [
        "reason"
      ]
    },
    "expansionRunning": "Expanding follow-up questions from your answers…",
    "expansionAdded": {
      "template": "Expansion finished: {qCount} new questions, {optCount} new options",
      "params": [
        "qCount",
        "optCount"
      ]
    },
    "expansionRetracted": "Answer changed, the previous expansion was withdrawn",
    "expansionStopped": "The answers already determine the next step; no further questions added",
    "expansionFailed": {
      "template": "Expansion failed: {reason} (answer on or submit as is)",
      "params": [
        "reason"
      ]
    }
  },
  "help": {
    "cancel": "Esc/Ctrl+C cancel",
    "clearNote": "x clear note",
    "confirmQuestion": "Enter confirm",
    "editFormNote": "n form supplement",
    "editNote": "n question note",
    "editOptionNote": "n option note",
    "editQuestionNote": "N question note",
    "jumpQuestion": "1-9 jump to question",
    "moveCursor": "↑↓/jk move",
    "scrollDraft": "[ ] scroll draft",
    "scrollSummary": "↑↓/[ ] scroll",
    "selectOptionSingle": "Space/Enter select",
    "switchQuestion": "Tab/←→/hl switch question",
    "toggleAll": "a select/clear all",
    "toggleCheckMulti": "Space toggle"
  },
  "summary": {
    "title": "[Answer Summary]",
    "statusDone": "[Done]",
    "statusPending": "[Pending]",
    "questionPrefix": {
      "template": "Q{index}: {title}",
      "params": [
        "index",
        "title"
      ]
    },
    "selectedLabel": "Selected:",
