        "label",
        "note"
      ]
    },
    "questionNoteTag": {
      "template": " ({icon.note} question note: {text})",
      "params": [
        "text"
      ]
    },
    "supplementLabel": "Form supplement",
    "errorBullet": {
      "template": "• Error: {err}",
      "params": [
        "err"
      ]
    }
