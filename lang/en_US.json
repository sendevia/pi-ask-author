      "template": "{icon.note} Option note ({optLabel}):",
      "params": [
        "optLabel"
      ]
    },
    "customNoteLabel": {
      "template": "{icon.note} Question note:"
    },
    "allDonePrompt": {
      "template": " {icon.check} All questions answered; confirm to submit"
    },
    "pendingWarning": {
      "template": " {icon.unchecked} Some questions are unanswered; confirming jumps to the first one"
    },
    "formNoteFilled": {
      "template": "{icon.note} Form supplement: {text}",
      "params": [
        "text"
      ]
    },
    "formNoteEmpty": {
      "template": "{icon.note} Form supplement (empty; press n or click here)"
    },
    "submitButton": {
      "template": "{icon.check} Submit answers"
    }
  },
  "card": {
    "callQuestionAndOptionCount": {
      "template": "{qCount} questions • {optCount} options",
      "params": [
        "qCount",
        "optCount"
      ]
    },
